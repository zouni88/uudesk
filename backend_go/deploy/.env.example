# 复制为 .env 后填写。docker compose 与 uudesk-server 共用。
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-32byte-random-secret
# 客户端连接地址（§10.3），反代后可改为 wss://<domain>
LIVEKIT_URL=wss://your-host:7881
# 公网 IP，供 TURN 通告
EXTERNAL_IP=203.0.113.10
# Go 服务器侧 Redis 地址（如后续改走 RPC 直发 egress 请求时使用）
REDIS_ADDR=redis:6379
